# Keystone configuration (02-ARCHITECTURE.md "Configuration").
# The app does not auto-load this file; set these in your shell or Docker.
# All values are optional and have safe defaults; no real secrets here.

# Session signing key. Omit for a random key per start (sessions end on restart).
# SECRET_KEY=replace-with-a-random-local-secret

# SQLite database file path. Default: instance/keystone.sqlite3
# (the Docker image sets /app/data/keystone.sqlite3).
# DATABASE=/absolute/path/to/local-demo.sqlite3

# Upload directory. Unused since CC01 (resumes are raw text); kept so the
# Dockerfile and this file do not change. Default: instance/uploads
# UPLOAD_DIR=/absolute/path/to/uploads

# Maximum upload size in MB. Default: 2
# MAX_UPLOAD_MB=2

# waitress port in Docker. Default: 8080
# PORT=8080
